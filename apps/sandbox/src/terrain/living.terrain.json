    { "id": "plateau-reservoir", "type": "flatten", "shape": { "kind": "circle", "center": [170, 200], "radius": 36, "falloff": 16 }, "params": { "y": 58 } },
    { "id": "plateau-work", "type": "flatten", "shape": { "kind": "circle", "center": [330, 200], "radius": 36, "falloff": 16 }, "params": { "y": 46 } },
    { "id": "plateau-rest", "type": "flatten", "shape": { "kind": "circle", "center": [330, 310], "radius": 36, "falloff": 16 }, "params": { "y": 46 } },
    { "id": "plateau-tower", "type": "flatten", "shape": { "kind": "circle", "center": [440, 300], "radius": 36, "falloff": 16 }, "params": { "y": 46 } }
  ]
