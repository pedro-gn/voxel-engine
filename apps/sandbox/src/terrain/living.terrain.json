      "params": { "height": 44, "roughness": 0.6, "noise": { "type": "ridged", "scale": 90, "octaves": 5 } }
    },
    {
      "id": "north-cave", "type": "cave",
      "shape": { "kind": "path", "width": 7, "points": [{ "x": 80, "z": 95, "y": 50 }, { "x": 100, "z": 70, "y": 54 }, { "x": 130, "z": 55, "y": 52 }] }
    },
    {
      "id": "centre-hills", "type": "hills",
      "shape": { "kind": "circle", "center": [300, 300], "radius": 150, "falloff": 50 },
      "params": { "amplitude": 8, "noise": { "scale": 50, "octaves": 3 } }
    },
    {
      "id": "river", "type": "river",
      "shape": { "kind": "path", "width": 9, "points": [{ "x": 262, "z": 90 }, { "x": 250, "z": 180 }, { "x": 266, "z": 280 }, { "x": 246, "z": 380 }, { "x": 232, "z": 430 }] },
      "params": { "start": 46, "end": 36, "depth": 3, "bank": 14, "bankSlope": 0.4 }
    },
    {
      "id": "lake", "type": "lake",
      "shape": { "kind": "circle", "center": [230, 455], "radius": 40 },
      "params": { "level": 36, "depth": 6, "shore": 16 }
    },
    {
      "id": "sea", "type": "hills", "blend": "min",
      "shape": { "kind": "polygon", "points": [[0, 380], [110, 360], [170, 420], [190, 512], [0, 512]], "falloff": 60 },
      "params": { "amplitude": 5, "offset": 16, "noise": { "scale": 40 } }
    },
    {
      "id": "coast", "type": "biome",
      "shape": { "kind": "polygon", "points": [[0, 380], [110, 360], [170, 420], [190, 512], [0, 512]], "falloff": 50 },
      "params": { "biome": "beach", "jitter": 10 }
