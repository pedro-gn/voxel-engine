{
  "format": "elovox-terrain",
  "version": 1,
  "size": [512, 512],
  "seaLevel": 30,
  "base": { "height": 40, "amplitude": 8, "noise": { "scale": 120, "octaves": 4, "warp": { "scale": 220, "amount": 24 } } },
  "biomes": [
    {
      "name": "temperate",
      "surface": [
        { "block": "stone", "slope": [1.6, 99] },
        { "block": "gravel", "underwater": true, "depth": [0, 1] },
        { "block": "sand", "nearWater": 2, "depth": [0, 2] },
        { "block": "stone", "ceiling": true, "depth": [0, 40] },
        { "block": "grass" },
        { "block": "dirt", "depth": [1, 3] }
      ],
      "trees": { "density": 0.1, "kinds": ["broadleaf", "broadleaf", "bush"] },
      "rocks": { "density": 0.015, "size": [1, 3] }
    },
    {
      "name": "alpine",
      "surface": [
        { "block": "stone", "slope": [1.3, 99] },
        { "block": "stone", "ceiling": true, "depth": [0, 40] },
        { "block": "snow" }
      ],
      "trees": { "density": 0.04, "kinds": ["pine"], "on": ["snow"] }
    },
    {
      "name": "beach",
      "surface": [
        { "block": "gravel", "underwater": true, "depth": [0, 1] },
        { "block": "sand", "depth": [0, 3] }
      ],
      "rocks": { "density": 0.05, "size": [2, 4] }
    }
  ],
  "biomeRule": {
    "default": "temperate",
    "moisture": { "scale": 140, "octaves": 3 },
    "rules": [{ "biome": "alpine", "minHeight": 80 }]
